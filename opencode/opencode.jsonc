{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-api/deepseek-v4-flash",
  "default_agent": "router",
  "theme": "dracula",
  "provider": {
    "bonsai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Bonsai (RTX 4070 Ti Super)",
      "options": {
        "baseURL": "http://127.0.0.1:18080/v1"
      },
      "models": {
        "bonsai-2-27b": {
          "name": "Ternary Bonsai 2 27B",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "capabilities": {
            "tools": true
          },
          "settings": {
            "compaction": {
              "auto": true,
              "buffer": 16384,
              "keep": {
                "tokens": 12000
              }
            }
          }
        }
      }
    },
    "deepseek-api": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek API",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "timeout": 60000
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek Pro",
          "contextWindow": 1000000
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek Flash",
          "contextWindow": 1000000
        }
      }
    },
    "relay-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Relay API",
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1",
        "timeout": 60000
      },
      "models": {
        "agy/gemini-4-argon": {
          "name": "Gemini 4 Argon",
          "contextWindow": 1048576
        },
        "agy/gemini-3.8-flash-medium": {
          "name": "Gemini 3.8 Flash",
          "contextWindow": 1048576
        },
      }
    }
  }

}
