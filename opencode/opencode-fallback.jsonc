{
  "enabled": true,
  "timeout_seconds": 1800,
  "max_fallback_attempts": 10,

  // 补上 "Model unavailable: ..." 这类错误
  "retryable_error_patterns": ["model unavailable", "model .* unavailable", ".*CLI completion failed"],

  "agents": {
    "flash-relay":   { "fallback_models": ["deepseek-api/deepseek-v4-flash"] },
    "tests-relay":   { "fallback_models": ["deepseek-api/deepseek-v4-flash"] },
    "explore-relay": { "fallback_models": ["deepseek-api/deepseek-v4-flash"] },
    "pro-relay":     { "fallback_models": ["relay-gateway/agy/claude-sonnet-5-5", "deepseek-api/deepseek-v4-pro"] },
    "review-relay":  { "fallback_models": ["relay-gateway/agy/claude-sonnet-5-5", "deepseek-api/deepseek-v4-pro"] },
    "plan-relay":    { "fallback_models": ["relay-gateway/agy/claude-sonnet-5-5", "deepseek-api/deepseek-v4-pro"] }
  }
}
